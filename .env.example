# THERMO CHAMPIONS: HEAT EDITION — CONTOH VARIABEL KONFIGURASI
# Salin konfigurasi ini dari Firebase Console -> Project Settings -> General -> Your apps -> Web app

VITE_FIREBASE_API_KEY=AIzaSyDummyKeyReplaceInSettings12345678
VITE_FIREBASE_AUTH_DOMAIN=thermo-champions.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://thermo-champions-default-rtdb.asia-southeast1.firebasedatabase.app
